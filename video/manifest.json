   "words": 10,
   "rms": 0.1044103279709816,
   "start": 0.469,
   "natural_start": 0.6,
   "natural_dur": 4.56
  },
  {
   "para": 0,
   "sent": 1,
   "text": "It opens with a real four frame walk cycle, not a mockup.",
