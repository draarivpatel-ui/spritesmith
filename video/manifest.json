   "words": 20,
   "rms": 0.11732276529073715,
   "start": 10.992,
   "natural_start": 14.07,
   "natural_dur": 8.24
  },
  {
   "para": 2,
   "sent": 0,
   "text": "Drawing happens on an exact eight, sixteen, or thirty two pixel grid.",
