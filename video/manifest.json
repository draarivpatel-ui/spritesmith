   "rms": 0.10635746270418167,
   "start": 21.969,
   "natural_start": 28.12,
   "natural_dur": 6.72
  },
  {
   "para": 3,
   "sent": 0,
   "text": "Frames can be duplicated, reordered by selection, repaired with undo, and checked live.",
